---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { src, alt, sizes = '(max-width: 760px) 60vw, 300px', eager = false, class: className } = Astro.props;
---

<figure class:list={['device', className]}>
  <Image
    src={src}
    alt={alt}
    widths={[300, 460, 640, 900]}
    sizes={sizes}
    format="webp"
    quality={80}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</figure>

<style>
  /* A raw capture in a thin titanium frame, sitting on paper. The screenshots
     are dark, so the frame is lighter than the screen and the shadow is soft
     and low: an object on a desk, not a floating card. */
  .device {
    position: relative;
    margin: 0;
    padding: 2.6%;
    border-radius: 15.5% / 7.2%;
    background: linear-gradient(160deg, #d9d6cf, #9d9a94 45%, #cfccc5);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.5),
      0 0 0 1px rgba(21, 23, 30, 0.12),
      0 2px 3px rgba(21, 23, 30, 0.08),
      0 28px 50px -24px rgba(21, 23, 30, 0.42);
  }
  .device :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 13.2% / 6.1%;
    background: #000;
  }
</style>
