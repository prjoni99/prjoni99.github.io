---
import { Image } from 'astro:assets';
import icon from '../assets/app-icon.png';
import { facts } from '../data/facts';

const path = Astro.url.pathname;
const links = [
  { label: 'Data Cards', href: '/cards/' },
  { label: 'Features', href: '/features/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'What’s new', href: '/whats-new/' },
  { label: 'Support', href: '/support/' },
];
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href="/" class="brand" aria-label="OneScribe, home">
      <Image src={icon} alt="" widths={[30, 60]} sizes="30px" format="webp" quality={85} class="brand__icon" loading="eager" />
      <span>OneScribe</span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <a class="button nav__cta" href={facts.appStoreUrl} rel="noopener">Download</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--ink);
  }
  :global(.brand__icon) {
    width: 30px;
    height: 30px;
    border-radius: 7px;
  }

  .nav__links {
    display: flex;
    gap: 1.6rem;
    margin-left: auto;
    font-size: 0.9375rem;
  }
  .nav__links a {
    color: var(--sub);
    text-decoration: none;
    transition: color 0.18s ease;
  }
  .nav__links a:hover,
  .nav__links a[aria-current='page'] { color: var(--ink); }

  .nav__cta { padding: 0.5rem 1rem; font-size: 0.9375rem; }

  @media (max-width: 820px) {
    .nav__inner { height: auto; flex-wrap: wrap; row-gap: 0.4rem; padding-block: 0.75rem; }
    .nav__cta { margin-left: auto; }
    .nav__links {
      order: 3;
      width: 100%;
      margin: 0;
      gap: 1.2rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.25rem;
    }
    .nav__links::-webkit-scrollbar { display: none; }
    .nav__links a { white-space: nowrap; }
  }
</style>
