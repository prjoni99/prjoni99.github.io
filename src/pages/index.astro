---
import Base from '../layouts/Base.astro';
import Device from '../components/Device.astro';
import PaperPass from '../components/PaperPass.astro';
import { facts, free, pro } from '../data/facts';

import boardingPass from '../assets/captures/boarding-pass.jpg';
import briefing from '../assets/captures/briefing.jpg';
import eventTicket from '../assets/captures/event-ticket.jpg';
import recipe from '../assets/captures/recipe.jpg';
import wineLabel from '../assets/captures/wine-label.jpg';
import businessCard from '../assets/captures/business-card.jpg';
import giftCard from '../assets/captures/gift-card.jpg';

// All captures use fictional data (Pacifica Air, Silverbrook Cellars, Arcadia
// Goods...). Real brands and personal data are banned; see PLAN.md §5.
const gallery = [
  { src: eventTicket, name: 'Event ticket', reads: 'Venue, date, doors, section, row and seat', then: 'Adds it to Calendar' },
  { src: recipe, name: 'Recipe', reads: 'Servings, times, ingredients and steps', then: 'Scales the servings' },
  { src: wineLabel, name: 'Wine label', reads: 'Producer, vintage, region and tasting notes', then: 'Keeps the bottle you liked' },
  { src: businessCard, name: 'Business card', reads: 'Name, title, company, phone and email', then: 'Saves it to Contacts' },
  { src: giftCard, name: 'Gift card', reads: 'Store, balance and card number', then: 'Keeps the balance where you can find it' },
];

const next = [
  { title: 'A daily briefing', body: 'Each morning, what needs attention: deadlines coming up and what you spent.' },
  { title: 'Alerts before it’s too late', body: 'A warranty about to lapse, a return window closing, a policy coming up for renewal.' },
  { title: 'Documents that find each other', body: 'A receipt finds its warranty. An invoice finds its payment. An insurance card finds the car it covers.' },
  { title: 'Ask in plain English', body: 'Search everything you’ve scanned, or ask a single document about its terms, dates and totals.' },
  { title: 'Exports that land in the right app', body: `${facts.exportModes} export modes: contracts to Calendar, cards to Contacts, notes to Reminders, receipts to a spreadsheet.` },
  { title: 'Siri and Shortcuts', body: 'Scan, search and open documents with your voice or from a Shortcut.' },
];

const faq = [
  {
    q: 'Which devices does it need?',
    a: `OneScribe runs on ${facts.platforms} with ${facts.requires}. Data Cards are read by Apple’s on-device model, which needs an ${facts.aiDevices}.`,
  },
  {
    q: 'Where are my documents read?',
    a: 'On your iPhone or iPad. There’s no OneScribe account, no OneScribe server and no analytics SDK. iCloud sync is off until you turn it on, and then it syncs to your own iCloud.',
  },
  {
    q: 'Is there a subscription?',
    a: `No. Scanning is free and unlimited. Pro is a one-time ${facts.proPrice} purchase that unlocks everything else, for good.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'OneScribe',
    operatingSystem: 'iOS 26, iPadOS 26',
    applicationCategory: 'ProductivityApplication',
    url: 'https://getonescribe.app',
    downloadUrl: facts.appStoreUrl,
    description: 'A document scanner that reads what it scans and turns each document into a structured Data Card, on your iPhone or iPad.',
    offers: [
      { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Pro (one-time)', price: facts.proPriceValue, priceCurrency: 'USD' },
    ],
    publisher: { '@type': 'Organization', name: 'Casa Vargas LLC', url: 'https://casavargas.app' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base schema={schema}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero__copy">
      <h1 id="hero-title" class="display">Every document has a story.</h1>
      <p class="lede hero__lede">
        OneScribe reads it on your iPhone or iPad and turns it into a Data Card: the details
        that matter, typed, searchable and ready to act on.
      </p>
      <div class="hero__actions">
        <a href={facts.appStoreUrl} rel="noopener" class="badge">
          <img src="/app-store-badge-black.svg" alt="Download on the App Store" width="150" height="50" />
        </a>
        <a href="/cards/" class="link">Browse the Data Cards</a>
      </div>
      <p class="small hero__meta">Free to scan, with no account. Pro is {facts.proPrice} once.</p>
    </div>

    <div class="hero__art">
      <PaperPass />
      <Device src={boardingPass} alt="The same boarding pass as a Data Card in OneScribe: flight PA 1924, gate C18, seat 7A, boarding 07:40" eager sizes="(max-width: 760px) 50vw, 280px" class="hero__phone" />
    </div>
  </section>

  <section class="band reads" aria-labelledby="reads-title">
    <div class="wrap">
      <header class="head">
        <h2 id="reads-title" class="title">It knows what it’s looking at.</h2>
        <p class="lede">
          OneScribe knows dozens of kinds of document, and each gets a Data Card built for it.
          A ticket gets its seat, a recipe its servings, a gift card its balance.
        </p>
      </header>
    </div>

    <ul class="gallery" aria-label="Examples of Data Cards">
      {gallery.map((g) => (
        <li class="gallery__item">
          <Device src={g.src} alt={`A ${g.name.toLowerCase()} Data Card in OneScribe`} sizes="(max-width: 760px) 62vw, 250px" />
          <h3>{g.name}</h3>
          <p>{g.reads}.</p>
          <p class="gallery__then">{g.then}.</p>
        </li>
      ))}
    </ul>

    <div class="wrap reads__more">
      <a class="link" href="/cards/">Browse the Data Card library</a>
    </div>
  </section>

  <section class="wrap next" aria-labelledby="next-title">
    <div class="next__art">
      <Device src={briefing} alt="OneScribe’s evening briefing: three documents with deadlines in 4, 11 and 23 days" sizes="(max-width: 760px) 70vw, 340px" />
    </div>
    <div class="next__copy">
      <h2 id="next-title" class="title">Then it keeps watch.</h2>
      <p class="lede">Scanning is where OneScribe starts. What it does with your documents afterwards is the point.</p>
      <dl class="next__list">
        {next.map((n) => (
          <div>
            <dt>{n.title}</dt>
            <dd>{n.body}</dd>
          </div>
        ))}
      </dl>
      <a class="link" href="/features/">Every feature, in detail</a>
    </div>
  </section>

  <section class="band private" aria-labelledby="private-title">
    <div class="wrap private__inner">
      <h2 id="private-title" class="title">Read on your device, not on ours.</h2>
      <div class="private__copy">
        <p class="lede">
          OneScribe reads your documents on your iPhone or iPad. There’s no OneScribe account,
          no OneScribe server and no analytics SDK.
        </p>
        <p>
          iCloud sync is off until you turn it on, and then your library syncs to your own
          iCloud. Exports go through the Share Sheet, straight to the app you choose.
        </p>
        <a class="link" href="/privacy/">Read the privacy policy</a>
      </div>
    </div>
  </section>

  <section class="wrap pricing" aria-labelledby="pricing-title">
    <header class="head head--center">
      <h2 id="pricing-title" class="title">Scan free. Pay once for the rest.</h2>
      <p class="lede">No subscription, no trial clock, no account.</p>
    </header>
    <div class="plans">
      <div class="plan">
        <h3>Free</h3>
        <p class="plan__price">$0</p>
        <ul>{free.map((f) => <li>{f}</li>)}</ul>
      </div>
      <div class="plan plan--pro">
        <h3>Pro</h3>
        <p class="plan__price">{facts.proPrice} <span>once</span></p>
        <ul>{pro.map((f) => <li>{f}</li>)}</ul>
      </div>
    </div>
    <p class="pricing__cta">
      <a href={facts.appStoreUrl} rel="noopener" class="button">Download OneScribe</a>
      <a class="link" href="/pricing/">Compare the plans</a>
    </p>
  </section>

  <section class="wrap faq" aria-labelledby="faq-title">
    <h2 id="faq-title" class="title">Questions</h2>
    <dl class="faq__list">
      {faq.map((f) => (
        <div>
          <dt>{f.q}</dt>
          <dd>{f.a}</dd>
        </div>
      ))}
    </dl>
    <p><a class="link" href="/support/">More answers in Support</a></p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(4rem, 9vw, 7rem);
  }
  .hero__lede { margin-top: 1.6rem; max-width: 30em; }
  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2rem;
  }
  .badge img { display: block; height: 50px; width: auto; }
  .hero__meta { margin: 1.2rem 0 0; }

  .hero__art {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 1rem 0 1rem 0;
  }
  /* Paper and phone side by side, overlapping only at the edge, so both
     can be read in full: the same boarding pass, before and after. */
  .hero__art :global(.pass) {
    width: 63%;
    margin-top: 4.5rem;
    position: relative;
    z-index: 1;
  }
  .hero__art :global(.hero__phone) {
    position: absolute;
    right: 0;
    top: 0;
    width: min(41%, 260px);
    z-index: 2;
  }

  .head { max-width: 44rem; }
  .head .lede { margin-top: 1.1rem; }
  .head--center { margin-inline: auto; text-align: center; }

  .reads { padding-block: clamp(4rem, 8vw, 6.5rem); }

  .gallery {
    list-style: none;
    display: flex;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0.5rem max(var(--gutter), calc((100vw - var(--page-max)) / 2 + var(--gutter))) 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .gallery__item {
    flex: 0 0 min(62vw, 250px);
    scroll-snap-align: start;
  }
  .gallery__item h3 {
    margin: 1.2rem 0 0.3rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .gallery__item p { margin: 0; color: var(--sub); font-size: 0.975rem; }
  .gallery__item .gallery__then { margin-top: 0.3rem; color: var(--ink); }
  .reads__more { margin-top: 1.5rem; }

  .next {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
    padding-block: clamp(4.5rem, 9vw, 7.5rem);
  }
  .next__art { position: sticky; top: 6rem; max-width: 340px; justify-self: center; width: 100%; }
  .next__copy .lede { margin-top: 1.1rem; max-width: 32em; }
  .next__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 2rem;
    margin: 2.5rem 0 2rem;
  }
  .next__list dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
  }
  .next__list dd { margin: 0.35rem 0 0; color: var(--sub); }

  .private { padding-block: clamp(4rem, 8vw, 6.5rem); }
  .private__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }
  .private__copy p { margin: 0 0 1.1rem; }
  .private__copy p:not(.lede) { color: var(--sub); max-width: 34em; }

  .pricing { padding-block: clamp(4.5rem, 9vw, 7rem) 0; }
  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 22rem));
    justify-content: center;
    gap: 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .plan {
    padding: 1.8rem 1.8rem 1.6rem;
    border-radius: 20px;
    background: #fff;
    box-shadow: var(--lift);
  }
  .plan--pro { box-shadow: var(--lift), 0 0 0 2px var(--ink); }
  .plan h3 { margin: 0; font-size: 1rem; font-weight: 600; color: var(--sub); }
  .plan__price {
    margin: 0.3rem 0 1.2rem;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .plan__price span { font-size: 1.1rem; font-weight: 600; letter-spacing: -0.01em; color: var(--sub); }
  .plan ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .plan li { padding-left: 1.5rem; position: relative; }
  .plan li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.42em;
    width: 0.7rem;
    height: 0.4rem;
    border-left: 2px solid var(--accent);
    border-bottom: 2px solid var(--accent);
    transform: rotate(-45deg);
  }
  .pricing__cta {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin: 2.2rem 0 0;
  }

  .faq { padding-block: clamp(4.5rem, 9vw, 7rem) 0; }
  .faq__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 3rem;
    margin: 2.2rem 0 2rem;
  }
  .faq__list dt { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.015em; }
  .faq__list dd { margin: 0.4rem 0 0; color: var(--sub); }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero__art { max-width: 34rem; }
    .next { grid-template-columns: 1fr; }
    .next__art { position: static; max-width: 280px; }
    .private__inner { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .next__list, .faq__list { grid-template-columns: 1fr; }
    .plans { grid-template-columns: 1fr; }
    .hero__art :global(.pass) { width: 64%; margin-top: 2.5rem; }
    .hero__art :global(.hero__phone) { width: 40%; }
  }
</style>
